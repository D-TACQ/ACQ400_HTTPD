#!/bin/sh

if [ ! -x /usr/local/CARE/diagsdump.new ]; then
    echo "Status: 500 Internal Server Error"
    echo "Content-Type: text/plain"
    echo ""
    echo "Error: /usr/local/CARE/diagsdump.new not found"
    exit 1
fi

OUTFILE="$(hostname).$(date +%y-%m-%d_%H-%M-%S).diagsdump.txt"

echo "Content-Type: text/plain"
echo "Content-Disposition: attachment; filename=\"$OUTFILE\""
echo ""

/usr/local/CARE/diagsdump.new
